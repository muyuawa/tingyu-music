<Project>
  <PropertyGroup>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(MuyuDiagnostics)' != 'true'">none</DebugType>
    <DebugSymbols Condition="'$(MuyuDiagnostics)' != 'true'">false</DebugSymbols>
  </PropertyGroup>
</Project>
