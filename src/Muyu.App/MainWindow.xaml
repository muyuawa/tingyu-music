<Window x:Class="Muyu.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Muyu.App" xmlns:core="using:Muyu.Core" Title="听屿">
  <Grid x:Name="Root" Background="{ThemeResource MuyuCanvasBrush}" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
    <Grid.Resources>
      <!-- Local mutable brushes avoid mutating the SDK's frozen theme resources. -->
      <SolidColorBrush x:Key="MuyuAccentBrush" Color="#245FCB"/>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#245FCB"/>
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#245FCB"/>
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#245FCB"/>
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#17202D"/>
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#17202D"/>
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#17202D"/>
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#17202D"/>
      <SolidColorBrush x:Key="TextControlForeground" Color="#17202D"/>
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F4F7FB"/>
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#245FCB"/>
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#245FCB"/>
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#245FCB"/>
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#245FCB"/>
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#245FCB"/>
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#245FCB"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#245FCB"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#245FCB"/>
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#245FCB"/>
      <!-- Uniform subtle edges replace the SDK's fixed bright top bevel. -->
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#185A6470"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#286A7480"/>
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#286A7480"/>
      <StaticResource x:Key="RepeatButtonBorderBrush" ResourceKey="ButtonBorderBrush"/>
      <StaticResource x:Key="RepeatButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver"/>
      <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="ButtonBorderBrush"/>
      <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver"/>
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ButtonBorderBrush"/>
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver"/>
      <DataTemplate x:Key="WrappedTextItem"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6" IsTextSelectionEnabled="True"/></DataTemplate>
      <Style x:Key="StretchListItem" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
      <Style TargetType="Button"><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="36"/></Style>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></Style>
      <Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
      <Style x:Key="GlassPlayButton" TargetType="Button"><Setter Property="UseSystemFocusVisuals" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="116"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="AtmosphereHost" Grid.RowSpan="3" Grid.ColumnSpan="2" IsHitTestVisible="False"/>
    <Border x:Name="SidebarBackdrop" Grid.RowSpan="2" Background="Transparent"/>
    <Border x:Name="TitleBarDragRegion" Grid.ColumnSpan="2" Height="48" Background="Transparent"/>
    <StackPanel x:Name="BrandPanel" IsHitTestVisible="False" Orientation="Horizontal" Spacing="10" Margin="22,0" VerticalAlignment="Center"><Image Source="Assets/app.png" Width="28" Height="28"/><TextBlock x:Name="Brand" Text="听屿" FontSize="20" FontWeight="SemiBold"/></StackPanel>
    <Button x:Name="ExitPlayerButton" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Background="Transparent" BorderThickness="0" Click="ExitPlayer_Click" ToolTipService.ToolTip="返回音乐库" AutomationProperties.Name="返回音乐库"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE70D;" FontSize="16"/><TextBlock Text="返回音乐库"/></StackPanel></Button>
    <Grid Grid.Column="1" Margin="40,0,148,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索音乐" MaxWidth="480" CornerRadius="20" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" QueryIcon="Find" TextChanged="Search_Changed"/>
      <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal"><Button x:Name="HeaderMiniButton" Style="{StaticResource IconButton}" Click="Mini_Click" ToolTipService.ToolTip="迷你播放器" AutomationProperties.Name="迷你播放器"><FontIcon Glyph="&#xE8A7;" FontSize="18"/></Button><Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button></StackPanel>
    </Grid>
    <Grid x:Name="NavigationHost" Grid.Row="1" Padding="12,16,12,16">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="NavigationGlass" Height="44" CornerRadius="22" VerticalAlignment="Top" IsHitTestVisible="False"/>
      <ListView x:Name="Navigation" SelectionChanged="Navigation_Changed" Background="Transparent" SelectionMode="Single">
        <ListView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/></ListView.Resources>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
        <ListViewItem Tag="home"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="17"/><TextBlock Text="首页"/></StackPanel></ListViewItem>
        <ListViewItem Tag="library"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8D6;" FontSize="17"/><TextBlock Text="全部歌曲"/></StackPanel></ListViewItem>
        <ListViewItem Tag="albums"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE93C;" FontSize="17"/><TextBlock Text="专辑"/></StackPanel></ListViewItem>
        <ListViewItem Tag="artists"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE77B;" FontSize="17"/><TextBlock Text="艺术家"/></StackPanel></ListViewItem>
        <ListViewItem Tag="genres"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8EC;" FontSize="17"/><TextBlock Text="流派"/></StackPanel></ListViewItem>
        <ListViewItem Tag="smart"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE945;" FontSize="17"/><TextBlock Text="智能歌单"/></StackPanel></ListViewItem>
        <ListViewItem Tag="folders"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="17"/><TextBlock Text="文件夹"/></StackPanel></ListViewItem>
        <ListViewItem Tag="favorites"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEB51;" FontSize="17"/><TextBlock Text="我喜欢的音乐"/></StackPanel></ListViewItem>
        <ListViewItem Tag="recent"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE81C;" FontSize="17"/><TextBlock Text="最近播放"/></StackPanel></ListViewItem>
        <ListViewItem Tag="playlists"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontSize="17"/><TextBlock Text="播放列表"/></StackPanel></ListViewItem>
        <ListViewItem Tag="now"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE768;" FontSize="17"/><TextBlock Text="正在播放"/></StackPanel></ListViewItem>
      </ListView>
      <StackPanel Grid.Row="1" Spacing="8"><Button x:Name="SidebarImport" Click="ImportFolder_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" ToolTipService.ToolTip="添加文件夹" AutomationProperties.Name="添加文件夹"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock x:Name="ImportLabel" Text="添加文件夹"/></StackPanel></Button><TextBlock x:Name="LibraryCount" Text="本地音乐库" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="10,0"/></StackPanel>
    </Grid>
    <Grid x:Name="ContentRegion" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="40,24,40,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>
      <Grid x:Name="LibraryPage" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="LibraryHeader" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="全部歌曲" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PageSubtitle" Text="本地音乐" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="Back_Click" Visibility="Collapsed" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><Button x:Name="PlaylistActions" Style="{StaticResource IconButton}" Click="PlaylistActions_Click" Visibility="Collapsed" ToolTipService.ToolTip="播放列表操作" AutomationProperties.Name="播放列表操作"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button><Button x:Name="PlayAllButton" Style="{StaticResource IconButton}" Click="PlayAll_Click" ToolTipService.ToolTip="播放全部" AutomationProperties.Name="播放全部"><FontIcon Glyph="&#xE768;" FontSize="18"/></Button><Button x:Name="LibraryMoreButton" Style="{StaticResource IconButton}" ToolTipService.ToolTip="音乐库操作" AutomationProperties.Name="音乐库操作"><FontIcon Glyph="&#xE712;" FontSize="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="添加音频文件" Click="ImportFiles_Click"/><MenuFlyoutItem Text="添加音乐文件夹" Click="ImportFolder_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="导入歌单" Click="ImportPlaylist_Click"/><MenuFlyoutItem Text="新建智能歌单" Click="SmartPlaylist_Click"/><MenuFlyoutItem Text="音乐管理" Click="CollectionActions_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="管理音乐目录" Click="ManageFolders_Click"/><MenuFlyoutItem Text="重新定位文件" Click="LocateFiles_Click"/></MenuFlyout></Button.Flyout></Button></StackPanel>
        </Grid>
        <StackPanel x:Name="LibraryToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16"><ComboBox x:Name="SortOrder" Width="224" Background="Transparent" BorderThickness="0" CornerRadius="16" SelectedIndex="0" SelectionChanged="Sort_Changed" AutomationProperties.Name="排序方式"><x:String>专辑 / 碟号 / 音轨</x:String><x:String>标题</x:String><x:String>艺术家</x:String><x:String>采样率</x:String><x:String>时长</x:String><x:String>文件修改时间 · 最新优先</x:String><x:String>文件修改时间 · 最早优先</x:String><x:String>添加时间 · 最新优先</x:String><x:String>添加时间 · 最早优先</x:String></ComboBox><ProgressBar x:Name="ScanProgress" Width="80" Visibility="Collapsed" IsIndeterminate="True"/></StackPanel>
        <ListView x:Name="TrackList" Grid.Row="2" Padding="0,0,0,144" SelectionMode="Extended" IsItemClickEnabled="False" DoubleTapped="Track_DoubleTapped" RightTapped="Track_RightTapped" Background="Transparent" ScrollViewer.HorizontalScrollMode="Disabled">
          <ListView.ItemTemplate><DataTemplate x:DataType="core:Track"><Grid Padding="6,12" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="{x:Bind DisplayTitle}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Artist}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{x:Bind Album}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind FormatText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Grid></DataTemplate></ListView.ItemTemplate>
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,2"/></Style></ListView.ItemContainerStyle>
        </ListView>
        <GridView x:Name="Groups" Grid.Row="2" Padding="0,0,0,144" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="Group_Click" RightTapped="Group_RightTapped" SelectionMode="None" Background="Transparent">
          <GridView.ItemTemplate><DataTemplate x:DataType="local:MusicGroup"><StackPanel Width="168" Spacing="8" Margin="0,0,12,20"><Border Width="168" Height="168" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="16"><Grid><FontIcon Glyph="&#xE93C;" FontSize="44" Opacity="0.35"/><Image Loaded="GroupCover_Loaded" DataContextChanged="GroupCover_DataContextChanged" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></GridView.ItemTemplate>
        </GridView>
        <StackPanel x:Name="EmptyLibrary" Grid.Row="2" Margin="0,0,0,144" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><FontIcon Glyph="&#xE8D6;" FontSize="52" Foreground="{ThemeResource MuyuAccentBrush}"/><TextBlock x:Name="EmptyText" Text="音乐，从这里开始" FontSize="22" HorizontalAlignment="Center"/><Button Content="添加本地音乐" Click="ImportFolder_Click" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
      <Grid x:Name="NowPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTipService.ToolTip="歌词选项" AutomationProperties.Name="歌词选项"><FontIcon Glyph="&#xE712;" FontSize="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="选择歌词来源" Click="ImportLyrics_Click"/><MenuFlyoutItem Text="校正歌词时间" Click="CorrectLyrics_Click"/><MenuFlyoutItem Text="清晰浏览 / 自动跟随" Click="ClearLyrics_Click"/></MenuFlyout></Button.Flyout></Button></Grid>
        <Grid x:Name="NowColumns" Grid.Row="1" Margin="0,20,0,8" ColumnSpacing="32" RowSpacing="20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
          <StackPanel x:Name="ArtworkPanel" VerticalAlignment="Center" Spacing="14" MaxWidth="440">
            <Grid x:Name="CoverFrame" Height="300" Width="300"><Grid x:Name="ArtworkShadowHost" IsHitTestVisible="False"/><Border CornerRadius="18" Background="{ThemeResource LayerFillColorAltBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="76" Foreground="{ThemeResource MuyuAccentBrush}" Opacity="0.35"/><Image x:Name="CoverImage" Stretch="UniformToFill"/></Grid></Border></Grid>
            <Grid x:Name="ArtworkMetadata" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock x:Name="SongTitle" Text="尚未选择歌曲" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SongArtist" Text="" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><Border x:Name="QualityBadge" HorizontalAlignment="Left" CornerRadius="10" Padding="9,4" Background="{ThemeResource ControlFillColorDefaultBrush}"><TextBlock x:Name="SongFormat" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border></StackPanel><Button x:Name="FavoriteButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="Favorite_Click" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏"><FontIcon x:Name="FavoriteIcon" Glyph="&#xEB51;" FontSize="19"/></Button></Grid>
          </StackPanel>
          <Grid x:Name="LyricsPanel" Grid.Column="1"><local:LyricsView x:Name="LyricsCanvas"/><StackPanel x:Name="NoLyrics" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><TextBlock Text="暂无歌词" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/><Button Content="选择歌词" Click="ImportLyrics_Click"/></StackPanel></Grid>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="TransportShadowHost" Grid.Row="2" Grid.ColumnSpan="2" Margin="56,0,56,24" Height="92" MaxWidth="1328" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
    <Border x:Name="TransportSurface" Grid.Row="2" Grid.ColumnSpan="2" Margin="56,0,56,24" Height="92" MaxWidth="1328" VerticalAlignment="Bottom" CornerRadius="46" Background="Transparent" BorderThickness="0">
      <Grid Margin="24,8" ColumnSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="TransportProgress" Grid.ColumnSpan="3" HorizontalAlignment="Center" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" FontSize="11" VerticalAlignment="Center"/><Slider x:Name="Progress" Grid.Column="1" Height="32" MinHeight="32" VerticalAlignment="Center" Minimum="0" Maximum="1" ValueChanged="Progress_Changed" AutomationProperties.Name="播放进度"><Slider.Resources><x:Double x:Key="SliderPreContentMargin">6</x:Double><x:Double x:Key="SliderPostContentMargin">6</x:Double></Slider.Resources></Slider><TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Button x:Name="TransportMetadata" Grid.RowSpan="2" VerticalAlignment="Center" Click="ShowNow_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="打开播放页" AutomationProperties.Name="{Binding Text,ElementName=MiniTitle}">
          <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="16" Opacity=".35"/><Image x:Name="TransportCover" Source="{Binding Source,ElementName=CoverImage,Mode=OneWay}" Stretch="UniformToFill"/></Grid></Border>
            <TextBlock x:Name="MiniTitle" Grid.Column="1" Text="尚未选择歌曲" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock x:Name="MiniArtist" Visibility="Collapsed"/>
          </Grid>
        </Button>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Click="Shuffle_Click" ToolTipService.ToolTip="随机播放" AutomationProperties.Name="随机播放"><FontIcon Glyph="&#xE8B1;" FontSize="18"/></Button><Button Style="{StaticResource IconButton}" Click="Previous_Click" ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="20"/></Button><Button x:Name="PlayButton" Style="{StaticResource GlassPlayButton}" Width="44" Height="44" Padding="0" BorderThickness="0" CornerRadius="22" Click="Play_Click" ToolTipService.ToolTip="播放 / 暂停" AutomationProperties.Name="播放"><FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="21"/></Button><Button Style="{StaticResource IconButton}" Click="Next_Click" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="20"/></Button><Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Click="Repeat_Click" ToolTipService.ToolTip="顺序播放" AutomationProperties.Name="播放模式"><FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="18"/></Button></StackPanel>
        <StackPanel x:Name="OutputButtons" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right"><Border x:Name="OutputBadge" CornerRadius="12" Padding="9,4" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center"><TextBlock x:Name="OutputBadgeText" Text="未建立输出" FontSize="11"/></Border><Button x:Name="VolumeButton" Style="{StaticResource IconButton}" Click="Volume_Click" ToolTipService.ToolTip="音量" AutomationProperties.Name="音量"><FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="19"/></Button><Slider x:Name="VolumeSlider" Width="80" Minimum="-40" Maximum="12" Value="0" StepFrequency="0.1" ValueChanged="VolumeSlider_Changed" IsEnabled="False" AutomationProperties.Name="音量"/><Button Style="{StaticResource IconButton}" Click="Queue_Click" ToolTipService.ToolTip="播放队列" AutomationProperties.Name="播放队列"><FontIcon Glyph="&#xE8F1;" FontSize="19"/></Button><Button x:Name="TransportMoreButton" Style="{StaticResource IconButton}" ToolTipService.ToolTip="更多播放选项" AutomationProperties.Name="更多播放选项"><FontIcon Glyph="&#xE712;" FontSize="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="音频信息" Click="AudioInfo_Click"/><MenuFlyoutItem Text="输出设备与音频设置" Click="Devices_Click"/><MenuFlyoutItem Text="迷你播放器" Click="Mini_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="停止播放" Click="Stop_Click"/></MenuFlyout></Button.Flyout></Button></StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="PopoverLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Border Background="Transparent" Tapped="DismissPopover_Tapped"/>
      <Border x:Name="FloatingSurface" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="360" Margin="24,0,24,140" Padding="24" CornerRadius="24"><ContentControl x:Name="FloatingContent" HorizontalContentAlignment="Stretch"/></Border>
    </Grid>
  </Grid>
</Window>
