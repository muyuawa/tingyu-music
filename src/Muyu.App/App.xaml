<Application x:Class="Muyu.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MuyuCanvasBrush" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="MuyuSidebarBrush" Color="#BFEAF0F8"/>
          <SolidColorBrush x:Key="MuyuSurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MuyuAccentBrush" Color="#245FCB"/>
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#17202D"/>
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#546275"/>
          <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#69778A"/>
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E6FFFFFF"/>
          <Color x:Key="SystemAccentColor">#245FCB</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MuyuCanvasBrush" Color="#11151D"/>
          <SolidColorBrush x:Key="MuyuSidebarBrush" Color="#BF101A29"/>
          <SolidColorBrush x:Key="MuyuSurfaceBrush" Color="#1A202B"/>
          <SolidColorBrush x:Key="MuyuAccentBrush" Color="#A9CEFF"/>
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F4F7FB"/>
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B5BFCE"/>
          <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8D9BAF"/>
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#D9252D3B"/>
          <Color x:Key="SystemAccentColor">#A9CEFF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="MuyuCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="MuyuSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="MuyuSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
          <SolidColorBrush x:Key="MuyuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
